<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modMenuRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. Floating 8-Ball Badge with Green Checkmark (Collapsed State) -->
    <FrameLayout
        android:id="@+id/layoutCollapsedBadge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_floating_8ball_base"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Center 8 Ball White Core -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_badge_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="8"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Lower-Right Green Checkmark Badge -->
        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_check_badge">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- 2. Main Aiming Master Modal Window (Expanded State) -->
    <FrameLayout
        android:id="@+id/layoutExpandedMenu"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aiming_master_dialog"
        android:padding="16dp"
        android:elevation="24dp"
        android:visibility="visible">

        <!-- VIEW A: MAIN AIMING MASTER MENU -->
        <LinearLayout
            android:id="@+id/viewAimingMasterMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Title Bar with Close "X" -->
            <RelativeLayout
                android:id="@+id/layoutHeaderDrag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Aiming Master"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMinimizeMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cushion shots and 3-line guidelines with Premium Basic"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <!-- TRY PREMIUM Button -->
            <LinearLayout
                android:id="@+id/btnTryPremium"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_try_premium"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRY PREMIUM"
                    android:textColor="#1A1C22"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Section 1: Current Cue Force Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#374151" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Current Cue Force "
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#374151" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set the Force of the cue you are currently using for more accurate rebound angle estimates based on shot power."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Clickable Cue Force Card -->
            <LinearLayout
                android:id="@+id/cardCueForce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_cue_force_item"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cue Force"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Segmented Bar Preview (12 segments: 0..11) -->
                <LinearLayout
                    android:id="@+id/layoutSegmentedBarMain"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvCueForceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Section 2: Game Training Analyzing Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#374151" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Game Training Analyzing "
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#374151" />
            </LinearLayout>

            <!-- Toggle 1: Support Cushion Shots -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Support Cushion Shots"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium Basic"
                        android:textColor="#1E222B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_premium"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCushionShots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </RelativeLayout>

            <!-- Toggle 2: Support 3-line Guideline -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Support 3-line Guideline"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium Basic"
                        android:textColor="#1E222B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_premium"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchThreeLines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </RelativeLayout>
        </LinearLayout>

        <!-- VIEW B: CUE FORCE SELECTION GRID (IMAGE 2 REPLICA) -->
        <LinearLayout
            android:id="@+id/viewCueForcePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Title Bar with Close "X" (Returns to Main Menu) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Cue Force"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseForcePicker"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <!-- 2-Column Force Grid (Force 0 to Force 11) -->
            <LinearLayout
                android:id="@+id/layoutForceGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Column 1: Evens (Force 0, 2, 4, 6, 8, 10) -->
                <LinearLayout
                    android:id="@+id/colForceEven"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical" />

                <!-- Column 2: Odds (Force 1, 3, 5, 7, 9, 11) -->
                <LinearLayout
                    android:id="@+id/colForceOdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</FrameLayout>
