<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modMenuRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. Circular Floating Mod Icon (Badge when minimized) -->
    <LinearLayout
        android:id="@+id/layoutCollapsedBadge"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_floating_circle"
        android:gravity="center"
        android:elevation="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 2. Expanded Floating Mod Menu (Open by default, 3 Tabs with Visuals as default) -->
    <LinearLayout
        android:id="@+id/layoutExpandedMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_mod_menu_card"
        android:padding="8dp"
        android:elevation="22dp"
        android:visibility="visible">

        <!-- ============================================== -->
        <!-- LEFT SIDEBAR: Avatar, Title, Tabs, Version    -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutSidebar"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="6dp"
            android:gravity="center_horizontal">

            <!-- Wizard Avatar & Title (Draggable Area) -->
            <LinearLayout
                android:id="@+id/layoutHeaderDrag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="🎯"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:background="@drawable/bg_floating_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aiming Master"
                    android:textColor="#F8FAFC"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E3A5F"
                android:layout_marginBottom="6dp" />

            <!-- Tab 1: Visuals (ACTIVE BY DEFAULT for easy calibration!) -->
            <LinearLayout
                android:id="@+id/btnTabVisuals"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tab_active"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁️"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTabVisualsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visuals"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Tab 2: Aim Menu -->
            <LinearLayout
                android:id="@+id/btnTabAimMenu"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTabAimText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aim Menu"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Tab 3: Settings -->
            <LinearLayout
                android:id="@+id/btnTabSettings"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTabSettingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Footer: Version & Minimize Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v3.0 Pro"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/btnMinimizeMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➖"
                    android:textColor="#94A3B8"
                    android:textSize="16sp"
                    android:padding="2dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1E3A5F" />

        <!-- ============================================== -->
        <!-- RIGHT CONTENT PANE: Tab Headers & Controls     -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <!-- Tab Header: Tab Title Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvCurrentTabTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visuals"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_blue"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E3A5F"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- ============================================== -->
                    <!-- PANE 1: VISUALS (TABLE & POCKET CONTROLS)      -->
                    <!-- ============================================== -->
                    <LinearLayout
                        android:id="@+id/layoutContentVisuals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- Setup / Calibration Mode Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_vip_card"
                            android:padding="6dp"
                            android:layout_marginBottom="6dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvModeTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🎯 وضع إعداد ومعايرة الطاولة (Setup Mode)"
                                    android:textColor="#FF1744"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchCalibrationMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvModeSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="افتح وضع التمرين (Practice) وطابق الحواف والجيوب الحمراء مع اللعبة تماماً ثم احفظ"
                                android:textColor="#94A3B8"
                                android:textSize="9sp"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/btnSaveCalibration"
                                android:layout_width="match_parent"
                                android:layout_height="26dp"
                                android:text="💾 حفظ وتثبيت الأبعاد وتفعيل وضع اللعب (Save &amp; Play)"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:background="#10B981"
                                android:layout_marginTop="5dp" />
                        </LinearLayout>

                        <!-- Manual Table Zoom -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📐 حجم الطاولة (Table Zoom)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true" />

                            <TextView
                                android:id="@+id/tvTableZoomVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textColor="#00E5FF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <SeekBar
                            android:id="@+id/seekTableZoom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="135"
                            android:progress="65"
                            android:layout_marginBottom="4dp" />

                        <!-- Manual Pocket Size Scaling -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🕳️ حجم الثقوب (Pocket Size)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true" />

                            <TextView
                                android:id="@+id/tvPocketSizeVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textColor="#FFD600"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <SeekBar
                            android:id="@+id/seekPocketSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="210"
                            android:progress="60"
                            android:layout_marginBottom="4dp" />

                        <!-- Table Position D-Pad: Move Table Left / Up / Down / Right -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎮 موضع الطاولة:"
                                android:textColor="#94A3B8"
                                android:textSize="10sp"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/btnCalibLeft"
                                android:layout_width="28dp"
                                android:layout_height="24dp"
                                android:text="⬅️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="3dp" />

                            <TextView
                                android:id="@+id/btnCalibUp"
                                android:layout_width="28dp"
                                android:layout_height="24dp"
                                android:text="⬆️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="3dp" />

                            <TextView
                                android:id="@+id/btnCalibDown"
                                android:layout_width="28dp"
                                android:layout_height="24dp"
                                android:text="⬇️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="3dp" />

                            <TextView
                                android:id="@+id/btnCalibRight"
                                android:layout_width="28dp"
                                android:layout_height="24dp"
                                android:text="➡️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/btnResetCalib"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:text="ضبط"
                                android:textColor="#F87171"
                                android:textSize="10sp"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />
                        </LinearLayout>

                        <!-- Auto-Fit DPI / Resolution Button -->
                        <TextView
                            android:id="@+id/btnAutoFitDpi"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:text="🎯 ضبط تلقائي للشاشة (Auto-Fit DPI)"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#0F172A"
                            android:layout_marginBottom="4dp" />

                        <!-- Master Laser Lines Toggle -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="خطوط التصويب والليزر"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchMasterAim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Table Cushions Toggle -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="إظهار حواف وجدران الطاولة"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchShowCushions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- ============================================== -->
                    <!-- PANE 2: AIM MENU CONTROLS                      -->
                    <!-- ============================================== -->
                    <LinearLayout
                        android:id="@+id/layoutContentAim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Row 1: Auto Aim(*) -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Auto Aim(*)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAutoAim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 2: Cue Ball Path -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="مسار الكرة البيضاء ومكان التوقف"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchCueBallPath"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 3: Bank Shots -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ارتدادات الجدران (Bank Shots)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchBankShots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 4: Aim Max Power (Text + Slider) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="2dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="قوة الضربة (Aim Max Power)"
                                    android:textColor="#F8FAFC"
                                    android:textSize="11sp"
                                    android:layout_alignParentStart="true" />

                                <TextView
                                    android:id="@+id/tvAimPowerVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.00"
                                    android:textColor="#38BDF8"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <SeekBar
                                android:id="@+id/seekAimPower"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="85" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ============================================== -->
                    <!-- PANE 3: SETTINGS & EXIT                        -->
                    <!-- ============================================== -->
                    <LinearLayout
                        android:id="@+id/layoutContentSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💡 قم بهز الهاتف في أي وقت لإخفاء أو إظهار هذه القائمة أثناء اللعب دون التأثير على خطوط التصويب."
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/btnCloseMod"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:text="❌ إغلاق التطبيق وإيقاف التتبع"
                            android:textColor="#EF4444"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#1E293B" />
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
