<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modMenuRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. Circular Floating Mod Icon (Matching Wizard iOS in the screenshot) -->
    <LinearLayout
        android:id="@+id/layoutCollapsedBadge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_floating_circle"
        android:gravity="center"
        android:elevation="18dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧙‍♂️"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 2. Expanded Floating Mod Menu (Matching Wizard iOS layout with Left Sidebar & Right Content) -->
    <LinearLayout
        android:id="@+id/layoutExpandedMenu"
        android:layout_width="470dp"
        android:layout_height="265dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_mod_menu_card"
        android:padding="8dp"
        android:elevation="22dp"
        android:visibility="gone">

        <!-- ============================================== -->
        <!-- LEFT SIDEBAR: Avatar, Title, Tabs, Version    -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="6dp"
            android:gravity="center_horizontal">

            <!-- Wizard Avatar & Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="🧙‍♂️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/bg_floating_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wizard iOS"
                    android:textColor="#F8FAFC"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E3A5F"
                android:layout_marginBottom="6dp" />

            <!-- Tab 1: Visuals -->
            <LinearLayout
                android:id="@+id/btnTabVisuals"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁️"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTabVisualsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visuals"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Tab 2: Aim Menu (Active by default) -->
            <LinearLayout
                android:id="@+id/btnTabAimMenu"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tab_active"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTabAimText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aim Menu"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Tab 3: Settings -->
            <LinearLayout
                android:id="@+id/btnTabSettings"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTabSettingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Footer: Version & Minimize Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v2.0"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/btnMinimizeMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➖"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:padding="2dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1E3A5F" />

        <!-- ============================================== -->
        <!-- RIGHT CONTENT PANE: Tab Headers & Controls     -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Tab Header: Tab Title Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvCurrentTabTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aim"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_blue"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E3A5F"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- PANE 1: AIM MENU (Exact controls from user's image) -->
                    <LinearLayout
                        android:id="@+id/layoutContentAim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- Row 1: Auto Aim(*) -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Auto Aim(*)"
                                android:textColor="#F8FAFC"
                                android:textSize="12sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAutoAim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 2: Auto Aim Toggle Icon -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Auto Aim Toggle Icon"
                                android:textColor="#F8FAFC"
                                android:textSize="12sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAimToggleIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 3: Auto Play -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Auto Play"
                                android:textColor="#F8FAFC"
                                android:textSize="12sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAutoPlay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 4: Nominate Pocket Manual -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nominate Pocket Manual"
                                android:textColor="#F8FAFC"
                                android:textSize="12sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchNominatePocket"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Row 5: Aim Max Power (Text + Value + Slider) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Aim Max Power"
                                    android:textColor="#F8FAFC"
                                    android:textSize="12sp"
                                    android:layout_alignParentStart="true" />

                                <TextView
                                    android:id="@+id/tvAimPowerVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.00"
                                    android:textColor="#38BDF8"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <SeekBar
                                android:id="@+id/seekAimPower"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="85" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- PANE 2: VISUALS (Manual Table & Pocket Scaling as requested!) -->
                    <LinearLayout
                        android:id="@+id/layoutContentVisuals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Manual Table Zoom -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📐 تصغير/تكبير الطاولة (Table Zoom)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true" />

                            <TextView
                                android:id="@+id/tvTableZoomVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textColor="#00E5FF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <SeekBar
                            android:id="@+id/seekTableZoom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="135"
                            android:progress="65"
                            android:layout_marginBottom="6dp" />

                        <!-- Manual Pocket Size Scaling -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🕳️ تصغير/تكبير الحفر (Pocket Size)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true" />

                            <TextView
                                android:id="@+id/tvPocketSizeVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textColor="#FFD600"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <SeekBar
                            android:id="@+id/seekPocketSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="210"
                            android:progress="60"
                            android:layout_marginBottom="6dp" />

                        <!-- Table Cushions Toggle -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="إظهار حواف وجدران الارتداد"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchShowCushions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Master Lines Toggle -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="إظهار خطوط التصويب والليزر"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchMasterAim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- PANE 3: SETTINGS -->
                    <LinearLayout
                        android:id="@+id/layoutContentSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ارتدادات الجدران (4 Banks)"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchBankShots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="مسار الكرة البيضاء ومكان التوقف"
                                android:textColor="#F8FAFC"
                                android:textSize="11sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchCueBallPath"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Calibration Offset D-Pad -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/btnCalibLeft"
                                android:layout_width="36dp"
                                android:layout_height="28dp"
                                android:text="⬅️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnCalibUp"
                                android:layout_width="36dp"
                                android:layout_height="28dp"
                                android:text="⬆️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnCalibDown"
                                android:layout_width="36dp"
                                android:layout_height="28dp"
                                android:text="⬇️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnCalibRight"
                                android:layout_width="36dp"
                                android:layout_height="28dp"
                                android:text="➡️"
                                android:gravity="center"
                                android:background="#1E293B"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnResetCalib"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="إعادة ضبط"
                                android:textColor="#F87171"
                                android:textSize="10sp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:gravity="center"
                                android:background="#1E293B" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnCloseMod"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:text="❌ إغلاق التطبيق بالكامل"
                            android:textColor="#EF4444"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:background="#1E293B" />
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
