<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header / Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎱 POOL AIM MASTER"
                android:textColor="@color/laser_green"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-Time Trajectory &amp; Physics Live Overlay"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الحالة: بانتظار منح إذن الظهور فوق التطبيقات"
                    android:textColor="@color/accent_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="يحتاج المساعد إلى صلاحية العرض فوق الشاشة وبث الشاشة لتتبع حركة العصا وشريط القوة تلقائياً في اللعبة."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="منح إذن الظهور فوق الشاشة"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="12dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="تشغيل المساعد المباشر (Start Live Assist)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_green"
            app:cornerRadius="16dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopOverlay"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="إيقاف المساعد (Stop Assist)"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/accent_red"
            app:cornerRadius="14dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchGame"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🎱 فتح لعبة 8 Ball Pool الآن"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="14dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ إعدادات الفيزياء ومسارات الارتداد"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• حساب مسار الكرة البيضاء بزاوية الانحراف 90° (Tangent Vector)"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• ارتداد الجدران الذكي (Cushion Bank Shots) حتى ارتدادين"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• محاكاة قوة الضربة ونقطة التوقف التام بفعل الاحتكاك (Friction Stop)"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• مؤشر التوهج الأخضر عند اصطفاف الكرة بدقة نحو الجيب"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
